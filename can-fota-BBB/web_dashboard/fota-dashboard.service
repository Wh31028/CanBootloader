[Unit]
Description=Automotive OTA Web Dashboard
After=network.target

[Service]
Type=simple
User=debian
WorkingDirectory=/home/debian/can-fota-BBB/web_dashboard
ExecStart=/bin/bash /home/debian/can-fota-BBB/web_dashboard/startup.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
